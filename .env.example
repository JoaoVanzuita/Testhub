# Local development placeholders only. Copy to `.env` and adjust locally.
# Never commit real secrets; `.env` is git-ignored.

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-local-development-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to true only behind HTTPS.
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=testhub
POSTGRES_USER=testhub
POSTGRES_PASSWORD=change-me-local-only
# Local runs reach the published port; `web`/`ai-worker` override this with `db`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
WEB_HOST_PORT=8000

# --- AI provider: Google Gemini via AI Studio (free tier, demo-only) --------
# See docs/ai-provider-decision.md and specs/002-integracao-ia-gemini/.
# PRIVACY: the free tier may use inputs to improve Google products, so only
# enable this with demonstration/seed data -- never real or sensitive data.
# Mocked tests run without any of these. Live calls require ALL of the explicit
# activation flag, an HTTPS endpoint, a model and a key; never commit a real key.
# AI_PROVIDER_ACTIVE=false                             # master approval switch (default: false)
# AI_PROVIDER_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# AI_PROVIDER_MODEL=                                   # required, free-tier model (e.g. gemini-3.8-flash)
# AI_PROVIDER_API_KEY=                                 # required, never versioned
# AI_PROVIDER_TIMEOUT_SECONDS=                         # bounded timeout (seconds)
